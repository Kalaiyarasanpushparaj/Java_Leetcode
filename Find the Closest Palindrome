class Solution {
    public String nearestPalindromic(String n) {
        long num = Long.parseLong(n);
        int len = n.length();
        if (num <= 10) return String.valueOf(num - 1);
        Set<Long> set = new HashSet<>();
        set.add((long)Math.pow(10, len - 1) - 1);
        set.add((long)Math.pow(10, len) + 1);
        long prefix = Long.parseLong(n.substring(0, (len + 1) / 2));
        for (long i = prefix - 1; i <= prefix + 1; i++) {
            String first = String.valueOf(i);
            String second = new StringBuilder(
                first.substring(0, len % 2 == 0 ? first.length() : first.length() - 1)
            ).reverse().toString();
            set.add(Long.parseLong(first + second));
        }
        set.remove(num);
        long ans = -1;
        long minDiff = Long.MAX_VALUE;
        for (long cand : set) {
            long diff = Math.abs(cand - num);
            if (diff < minDiff || (diff == minDiff && cand < ans)) {
                minDiff = diff;
                ans = cand;
            }
        }
        return String.valueOf(ans);
    }
}
